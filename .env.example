# MinerU 4.x Adapter 配置（3.x 服务请使用 main 分支）

# MinerU API 地址
MINERU_API_URL=https://mineru.1100111.net/v1/file_parse

# PDF/图片解析档位：flash/basic/standard/advanced；Office 文件使用 flash
MINERU_TIER=standard

# 整次解析预算（秒），应小于调用方及代理的超时
MINERU_TIMEOUT=570

# 客户侧可访问的图片基础 URL
PUBLIC_BASE_URL=http://127.0.0.1:3333/mineru_images

# 是否提取页眉 (true/false)
MINERU_ENABLE_PAGE_HEADER=false

# 服务端口
PORT=3333
